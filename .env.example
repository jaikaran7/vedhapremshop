# The browser always calls this site. Next.js forwards /api/v1 to the API, so the login cookie stays here.
# Do not point the browser at the API host. That is a different site and the session is dropped.
NEXT_PUBLIC_API_BASE_URL=/api/v1

# Server-only. Local default is http://127.0.0.1:4000 when this is unset.
# On Vercel set the backend origin with no path, for example https://vedhapremshop-be.vercel.app
# API_PROXY_ORIGIN=
